---
import fs from 'node:fs';
import path from 'node:path';
import rankingsData from '../data/rankings.json';
import midtermsData from '../data/midterms2026.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stateNames: Record<string, string> = {
  AL: "Alabama", AK: "Alaska", AZ: "Arizona", AR: "Arkansas", CA: "California",
  CO: "Colorado", CT: "Connecticut", DE: "Delaware", FL: "Florida", GA: "Georgia",
  HI: "Hawaii", ID: "Idaho", IL: "Illinois", IN: "Indiana", IA: "Iowa",
  KS: "Kansas", KY: "Kentucky", LA: "Louisiana", ME: "Maine", MD: "Maryland",
  MA: "Massachusetts", MI: "Michigan", MN: "Minnesota", MS: "Mississippi", MO: "Missouri",
  MT: "Montana", NE: "Nebraska", NV: "Nevada", NH: "New Hampshire", NJ: "New Jersey",
  NM: "New Mexico", NY: "New York", NC: "North Carolina", ND: "North Dakota", OH: "Ohio",
  OK: "Oklahoma", OR: "Oregon", PA: "Pennsylvania", RI: "Rhode Island", SC: "South Carolina",
  SD: "South Dakota", TN: "Tennessee", TX: "Texas", UT: "Utah", VT: "Vermont",
  VA: "Virginia", WA: "Washington", WV: "West Virginia", WI: "Wisconsin", WY: "Wyoming",
  DC: "District of Columbia"
};

const allMembers = [
  ...rankingsData.senate.map((s: any) => ({ ...s, chamber: "senate", chamberLabel: "Senate" })),
  ...rankingsData.house.map((h: any) => ({ ...h, chamber: "house", chamberLabel: "House" }))
];

const stateMap: Record<string, any> = {};

Object.keys(stateNames).forEach(code => {
  stateMap[code] = {
    code,
    name: stateNames[code],
    avgScore: 0,
    totalMembers: 0,
    totalScore: 0,
    repCount: 0,
    demCount: 0,
    indCount: 0,
    senators: [],
    reps: []
  };
});

allMembers.forEach(m => {
  if (!stateMap[m.state]) return;
  const s = stateMap[m.state];
  s.totalMembers++;
  s.totalScore += m.score;
  if (m.chamber === "senate") s.senators.push(m);
  else s.reps.push(m);

  if (m.party === "Republican") s.repCount++;
  else if (m.party === "Democrat") s.demCount++;
  else s.indCount++;
});

// Color scales
function getChoroplethColor(score: number): string {
  if (score >= 85) return "#b71c1c"; // Deep Red (High loyalty)
  if (score >= 70) return "#e53935"; // Red / Orange
  if (score >= 50) return "#8e44ad"; // Purple (Mixed / Divided)
  if (score >= 35) return "#2980b9"; // Blue
  return "#1565c0";                  // Deep Blue (Strong opposition)
}

function getMidtermChoroplethColor(code: string): string {
  const m = (midtermsData.states as any)[code];
  if (!m) return "#e0e0e0";
  if (m.netTotalGainDem >= 2) return "#1565c0"; // Deep Blue (Multi-seat Dem pickup)
  if (m.netTotalGainDem === 1) return "#42a5f5"; // Sky Blue (Dem pickup)
  if (["OH", "TX", "GA", "WA", "NV", "AZ"].includes(code)) return "#8e44ad"; // Battleground Hold / Split
  return "#e57373"; // GOP Hold / Red
}

function scoreTextColor(score: number): string {
  return (score > 30 && score < 70) ? '#111' : '#fff';
}

Object.values(stateMap).forEach(s => {
  s.avgScore = s.totalMembers > 0 ? parseFloat((s.totalScore / s.totalMembers).toFixed(1)) : 0;
  s.color = getChoroplethColor(s.avgScore);
  s.midtermColor = getMidtermChoroplethColor(s.code);
  s.midterm = (midtermsData.states as any)[s.code] || null;
  s.senators.sort((a: any, b: any) => b.score - a.score);
  s.reps.sort((a: any, b: any) => b.score - a.score);
});

// Sort state list in ALPHABETICAL order
const sortedStates = Object.values(stateMap).sort((a, b) => a.name.localeCompare(b.name));

// Process the raw SVG map ensuring responsive viewBox auto-fit
let svgContent = '';
try {
  const svgPath = path.resolve('./src/assets/us_map.svg');
  let raw = fs.readFileSync(svgPath, 'utf8');
  raw = raw.replace(/<\?xml[^>]*\?>/, '');
  raw = raw.replace(/<title>.*?<\/title>/, '');
  // Guarantee viewBox and id on the root SVG element
  raw = raw.replace(/<svg\b[^>]*>/, '<svg id="usMapSvg" viewBox="0 0 959 593" preserveAspectRatio="xMidYMid meet" width="100%" height="100%">');
  raw = raw.replace(/<path class="([a-z]{2})"/g, (match, code) => {
    return `<path class="state-path ${code}" data-state="${code.toUpperCase()}"`;
  });
  raw = raw.replace(/<circle class="state borders dccircle dc"/, `<circle class="state-path dccircle dc" data-state="DC"`);
  svgContent = raw;
} catch (e) {
  console.error("Failed to read SVG map:", e);
}

// Build state CSS rules for coloring
const stateColorStyles = Object.values(stateMap).map(s => {
  return `.us-map-wrapper .state-path.${s.code.toLowerCase()} { fill: ${s.color}; }`;
}).join('\n');
---

<section class="map-section" aria-labelledby="map-title">
    <div class="map-header">
        <h3 id="map-title">State-By-State Trump Loyalty Map</h3>
        <p class="map-subtitle" id="mapSubtitle">
            Average Congressional delegation Trump loyalty score across all 50 states (how frequently lawmakers vote in alignment with Trump's agenda). 
            Click any state or select from the dropdown to see its Senators and Representatives.
        </p>
    </div>

    <!-- Quick Dropdown Controls (Alphabetical Order) -->
    <div class="map-controls">
        <label for="stateSelect" class="control-label">Jump to State:</label>
        <select id="stateSelect" class="state-select">
            <option value="">-- Choose a State ({sortedStates.length}) --</option>
            {sortedStates.map(st => (
                <option value={st.code}>
                    {st.name} ({st.code}) &mdash; {st.avgScore}% Trump Loyalty ({st.repCount}R / {st.demCount}D)
                </option>
            ))}
        </select>
    </div>

    <!-- Layout: Map & Delegation Card -->
    <div class="map-layout">
        <div class="map-container">
            <!-- Map Toolbar with Layer Switcher & Zoom & Fit Controls -->
            <div class="map-toolbar">
                <!-- Layer Toggle Switch -->
                <div class="layer-switch" role="tablist" aria-label="Map Overlays">
                    <button type="button" class="layer-btn active" id="layerBtnLoyalty" data-layer="loyalty">
                        🔥 Loyalty Heatmap
                    </button>
                    <button type="button" class="layer-btn" id="layerBtnMidterms" data-layer="midterms">
                        🗳️ 2026 Midterm Shift
                    </button>
                </div>

                <div class="zoom-controls" role="group" aria-label="Map Zoom and Fit Controls">
                    <button type="button" id="zoomInBtn" class="zoom-btn" title="Zoom in" aria-label="Zoom in">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                    <button type="button" id="zoomOutBtn" class="zoom-btn" title="Zoom out" aria-label="Zoom out">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                    <button type="button" id="zoomResetBtn" class="zoom-btn reset-btn" title="Fit to screen" aria-label="Reset zoom and fit to screen">
                        &#x21ba; Fit Map
                    </button>
                    <span class="zoom-badge" id="zoomLevel">100%</span>
                </div>
                <span class="pan-hint" id="panHint">Click state &bull; Use &plus; / &minus; to zoom</span>
            </div>

            <!-- SVG Map Wrapper (Auto-fits on load) -->
            <div class="us-map-wrapper" id="usMapWrapper" set:html={svgContent} />

            <!-- Map Choropleth Legend (Loyalty) -->
            <div class="map-legend" id="legendLoyalty" aria-label="Loyalty map color legend">
                <span class="legend-title">Delegation Trump Alignment:</span>
                <div class="legend-scale">
                    <span class="legend-item"><span class="legend-swatch" style="background:#1565c0;"></span> &lt;35% (Strong Opposition)</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#2980b9;"></span> 35&ndash;49% (Opposition Leaning)</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#8e44ad;"></span> 50&ndash;69% (Split / Leans Trump)</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#e53935;"></span> 70&ndash;84% (High Trump Loyalty)</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#b71c1c;"></span> 85%+ (Heavy MAGA Lockstep)</span>
                </div>
            </div>

            <!-- Map Choropleth Legend (2026 Midterms) -->
            <div class="map-legend" id="legendMidterms" aria-label="2026 Midterm shift map color legend" style="display:none;">
                <span class="legend-title">2026 Midterms:</span>
                <div class="legend-scale">
                    <span class="legend-item"><span class="legend-swatch" style="background:#1565c0;"></span> +2&ndash;3 Dem Pickups</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#42a5f5;"></span> +1 Dem Pickup</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#8e44ad;"></span> Battleground Hold</span>
                    <span class="legend-item"><span class="legend-swatch" style="background:#e57373;"></span> GOP Stronghold</span>
                </div>
            </div>
        </div>

        <!-- Live Delegation Card -->
        <aside class="delegation-panel" id="delegationPanel" aria-live="polite">
            <div class="panel-placeholder" id="panelPlaceholder">
                <div class="placeholder-icon">🗺️</div>
                <h4>Select a State</h4>
                <p>Click any state on the map or use the dropdown to inspect its Senators and Representatives.</p>
            </div>

            <div class="panel-content" id="panelContent" style="display:none;">
                <div class="panel-header">
                    <div class="state-title-row">
                        <h4 id="panelStateName">Oklahoma</h4>
                        <span class="state-badge" id="panelStateScore">91.4%</span>
                    </div>
                    <div class="state-meta" id="panelStateMeta">
                        7 Members &bull; 7 Republicans &bull; 0 Democrats
                    </div>
                </div>

                <!-- 2026 Midterm Outcome Banner for this State -->
                <div class="panel-midterm-box" id="panelMidtermBox" style="display:none;">
                    <div class="midterm-banner-title" id="panelMidtermTitle"></div>
                    <div class="midterm-banner-body" id="panelMidtermBody"></div>
                </div>

                <!-- Senators Section -->
                <div class="chamber-section">
                    <div class="section-title">U.S. Senators (2)</div>
                    <div class="member-list" id="panelSenators"></div>
                </div>

                <!-- Representatives Section -->
                <div class="chamber-section">
                    <div class="section-title">Representatives (<span id="repCountNum">5</span>)</div>
                    <div class="member-list" id="panelReps"></div>
                </div>
            </div>
        </aside>
    </div>
</section>

<!-- Inject data for client-side interactivity -->
<script id="stateDataJson" type="application/json" set:html={JSON.stringify(stateMap)} />
<script id="basePathJson" type="application/json" set:html={JSON.stringify(base)} />

<script type="module">
    const stateDataEl = document.getElementById('stateDataJson');
    const basePathEl = document.getElementById('basePathJson');
    if (stateDataEl) {
        const stateMap = JSON.parse(stateDataEl.textContent || '{}');
        const base = JSON.parse(basePathEl.textContent || '""');

        const mapWrapper = document.getElementById('usMapWrapper');
        const svgEl = document.getElementById('usMapSvg');
        const stateSelect = document.getElementById('stateSelect');
        const panelPlaceholder = document.getElementById('panelPlaceholder');
        const panelContent = document.getElementById('panelContent');

        const panelStateName = document.getElementById('panelStateName');
        const panelStateScore = document.getElementById('panelStateScore');
        const panelStateMeta = document.getElementById('panelStateMeta');
        const panelSenators = document.getElementById('panelSenators');
        const panelReps = document.getElementById('panelReps');
        const repCountNum = document.getElementById('repCountNum');

        const zoomInBtn = document.getElementById('zoomInBtn');
        const zoomOutBtn = document.getElementById('zoomOutBtn');
        const zoomResetBtn = document.getElementById('zoomResetBtn');
        const zoomLevelEl = document.getElementById('zoomLevel');
        const panHint = document.getElementById('panHint');

        // SVG Coordinate system base
        const BASE_W = 959;
        const BASE_H = 593;
        let zoom = 1.0;
        let panX = 0;
        let panY = 0;

        function updateViewBox() {
            if (!svgEl) return;
            const w = BASE_W / zoom;
            const h = BASE_H / zoom;

            // Constrain pan within logical bounds
            panX = Math.max(0, Math.min(BASE_W - w, panX));
            panY = Math.max(0, Math.min(BASE_H - h, panY));

            svgEl.setAttribute('viewBox', `${panX} ${panY} ${w} ${h}`);
            if (zoomLevelEl) {
                zoomLevelEl.textContent = `${Math.round(zoom * 100)}%`;
            }

            if (zoom > 1.0) {
                mapWrapper.classList.add('can-pan');
                if (panHint) panHint.textContent = 'Drag to pan around map';
            } else {
                mapWrapper.classList.remove('can-pan');
                if (panHint) panHint.textContent = 'Click state \u2022 Use + / \u2212 to zoom';
            }
        }

        function zoomIn() {
            if (zoom >= 3.5) return;
            const oldW = BASE_W / zoom;
            const oldH = BASE_H / zoom;
            zoom = Math.min(3.5, parseFloat((zoom + 0.35).toFixed(2)));
            const newW = BASE_W / zoom;
            const newH = BASE_H / zoom;
            panX += (oldW - newW) / 2;
            panY += (oldH - newH) / 2;
            updateViewBox();
        }

        function zoomOut() {
            if (zoom <= 1.0) return;
            const oldW = BASE_W / zoom;
            const oldH = BASE_H / zoom;
            zoom = Math.max(1.0, parseFloat((zoom - 0.35).toFixed(2)));
            const newW = BASE_W / zoom;
            const newH = BASE_H / zoom;
            panX += (oldW - newW) / 2;
            panY += (oldH - newH) / 2;
            if (zoom === 1.0) {
                panX = 0;
                panY = 0;
            }
            updateViewBox();
        }

        function resetZoom() {
            zoom = 1.0;
            panX = 0;
            panY = 0;
            updateViewBox();
        }

        if (zoomInBtn) zoomInBtn.addEventListener('click', zoomIn);
        if (zoomOutBtn) zoomOutBtn.addEventListener('click', zoomOut);
        if (zoomResetBtn) zoomResetBtn.addEventListener('click', resetZoom);

        // Drag to Pan
        let isDragging = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let startPanX = 0;
        let startPanY = 0;
        let hasMoved = false;

        if (mapWrapper) {
            mapWrapper.addEventListener('mousedown', (e) => {
                if (e.button !== 0 || zoom <= 1.0) return;
                isDragging = true;
                hasMoved = false;
                dragStartX = e.clientX;
                dragStartY = e.clientY;
                startPanX = panX;
                startPanY = panY;
                mapWrapper.classList.add('is-panning');
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                const dx = e.clientX - dragStartX;
                const dy = e.clientY - dragStartY;
                if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
                    hasMoved = true;
                }
                const rect = svgEl.getBoundingClientRect();
                const scaleFactor = (BASE_W / zoom) / rect.width;
                panX = startPanX - dx * scaleFactor;
                panY = startPanY - dy * scaleFactor;
                updateViewBox();
            });

            window.addEventListener('mouseup', () => {
                if (isDragging) {
                    isDragging = false;
                    mapWrapper.classList.remove('is-panning');
                }
            });

            // Touch support
            mapWrapper.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1 && zoom > 1.0) {
                    isDragging = true;
                    hasMoved = false;
                    dragStartX = e.touches[0].clientX;
                    dragStartY = e.touches[0].clientY;
                    startPanX = panX;
                    startPanY = panY;
                }
            }, { passive: true });

            mapWrapper.addEventListener('touchmove', (e) => {
                if (!isDragging || e.touches.length !== 1) return;
                const dx = e.touches[0].clientX - dragStartX;
                const dy = e.touches[0].clientY - dragStartY;
                if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
                    hasMoved = true;
                }
                const rect = svgEl.getBoundingClientRect();
                const scaleFactor = (BASE_W / zoom) / rect.width;
                panX = startPanX - dx * scaleFactor;
                panY = startPanY - dy * scaleFactor;
                updateViewBox();
            }, { passive: true });

            mapWrapper.addEventListener('touchend', () => {
                isDragging = false;
            });

            // Double-click to toggle zoom
            mapWrapper.addEventListener('dblclick', (e) => {
                e.preventDefault();
                if (zoom < 2.5) {
                    zoomIn();
                } else {
                    resetZoom();
                }
            });
        }

        const layerBtnLoyalty = document.getElementById('layerBtnLoyalty');
        const layerBtnMidterms = document.getElementById('layerBtnMidterms');
        const legendLoyalty = document.getElementById('legendLoyalty');
        const legendMidterms = document.getElementById('legendMidterms');
        const mapSubtitle = document.querySelector('.map-subtitle');

        const panelMidtermBox = document.getElementById('panelMidtermBox');
        const panelMidtermTitle = document.getElementById('panelMidtermTitle');
        const panelMidtermBody = document.getElementById('panelMidtermBody');

        let currentLayer = 'loyalty';
        let selectedStateCode = 'OK';

        function applyLayer(layer) {
            currentLayer = layer;
            if (layer === 'loyalty') {
                layerBtnLoyalty?.classList.add('active');
                layerBtnMidterms?.classList.remove('active');
                if (legendLoyalty) legendLoyalty.style.display = 'flex';
                if (legendMidterms) legendMidterms.style.display = 'none';
                if (mapSubtitle) mapSubtitle.textContent = 'Average Congressional delegation Trump loyalty score across all 50 states (how frequently lawmakers vote in alignment with Trump\'s agenda). Click any state or select from the dropdown to see its Senators and Representatives.';
                Object.values(stateMap).forEach(s => {
                    document.querySelectorAll(`.state-path.${s.code.toLowerCase()}`).forEach(p => {
                        p.style.fill = s.color;
                    });
                });
            } else {
                layerBtnMidterms?.classList.add('active');
                layerBtnLoyalty?.classList.remove('active');
                if (legendMidterms) legendMidterms.style.display = 'flex';
                if (legendLoyalty) legendLoyalty.style.display = 'none';
                if (mapSubtitle) mapSubtitle.textContent = '2026 Midterm Election Results: Net Congressional seat changes and flipped districts following the November 2026 election.';
                Object.values(stateMap).forEach(s => {
                    document.querySelectorAll(`.state-path.${s.code.toLowerCase()}`).forEach(p => {
                        p.style.fill = s.midtermColor;
                    });
                });
            }
            if (selectedStateCode) {
                selectState(selectedStateCode);
            }
        }

        if (layerBtnLoyalty) layerBtnLoyalty.addEventListener('click', () => applyLayer('loyalty'));
        if (layerBtnMidterms) layerBtnMidterms.addEventListener('click', () => applyLayer('midterms'));

        function renderMemberRow(m, st) {
            const partyDotClass = m.party === 'Republican' ? 'r' : (m.party === 'Democrat' ? 'd' : 'i');
            const rankLabel = m.rank ? `#${m.rank}` : '';
            const isOusted = st?.midterm?.oustedIncumbents?.some((name) => m.name.includes(name));
            return `
                <a href="${base}/subjects/${m.subjectId}/" class="member-row ${isOusted ? 'is-ousted' : ''}">
                    <div class="member-info">
                        <span class="party-dot ${partyDotClass}"></span>
                        <span class="member-name">${m.name}</span>
                        ${rankLabel ? `<span class="member-rank">${rankLabel}</span>` : ''}
                        ${isOusted ? `<span class="ousted-pill" title="Defeated in the November 2026 General Election">💥 Ousted</span>` : ''}
                    </div>
                    <span class="member-score" style="background:${getScoreColor(m.score)}; color:${getScoreTextColor(m.score)}" title="Trump Loyalty Score: ${m.score.toFixed(1)}% (${m.pro} of ${m.total} votes)">
                        ${m.score.toFixed(1)}%
                    </span>
                </a>
            `;
        }

        function getScoreColor(score) {
            if (score >= 85) return "#b71c1c";
            if (score >= 70) return "#e53935";
            if (score >= 50) return "#8e44ad";
            if (score >= 35) return "#2980b9";
            return "#1565c0";
        }

        function getScoreTextColor(score) {
            return (score > 30 && score < 70) ? '#111' : '#fff';
        }

        function selectState(code) {
            if (!code || !stateMap[code]) {
                panelPlaceholder.style.display = 'block';
                panelContent.style.display = 'none';
                document.querySelectorAll('.state-path.active').forEach(p => p.classList.remove('active'));
                return;
            }

            selectedStateCode = code;
            const st = stateMap[code];

            // Highlight path in SVG
            document.querySelectorAll('.state-path.active').forEach(p => p.classList.remove('active'));
            const matchingPaths = document.querySelectorAll(`.state-path.${code.toLowerCase()}`);
            matchingPaths.forEach(p => p.classList.add('active'));

            // Sync dropdown
            if (stateSelect.value !== code) {
                stateSelect.value = code;
            }

            // Populate Panel
            panelStateName.textContent = `${st.name} (${st.code})`;
            panelStateScore.textContent = currentLayer === 'midterms' ? `${st.avgScore}%` : `${st.avgScore}% Trump Loyalty`;
            panelStateScore.style.background = currentLayer === 'midterms' ? st.midtermColor : st.color;
            panelStateScore.style.color = getScoreTextColor(st.avgScore);

            const breakdown = [];
            if (st.repCount > 0) breakdown.push(`${st.repCount} R`);
            if (st.demCount > 0) breakdown.push(`${st.demCount} D`);
            if (st.indCount > 0) breakdown.push(`${st.indCount} I`);
            panelStateMeta.textContent = `${st.totalMembers} Members (${breakdown.join(' \u2022 ') || 'None tracked'})`;

            // Populate Midterm Results Box
            if (panelMidtermBox) {
                if (st.midterm && (st.midterm.netTotalGainDem !== 0 || st.midterm.oustedIncumbents?.length > 0 || currentLayer === 'midterms')) {
                    panelMidtermBox.style.display = 'block';
                    const shiftNum = st.midterm.netTotalGainDem || 0;
                    const shiftTag = shiftNum > 0 ? `+${shiftNum} Dem Gain` : (shiftNum < 0 ? `+${Math.abs(shiftNum)} GOP Gain` : 'No Net Seat Change');
                    const badgeClass = shiftNum > 0 ? 'gain-dem' : (shiftNum < 0 ? 'gain-gop' : 'neutral');
                    panelMidtermTitle.innerHTML = `<span class="midterm-flag">🗳️ 2026 Midterms:</span> <span class="midterm-shift-tag ${badgeClass}">${shiftTag}</span>`;
                    let html = `<p class="midterm-summary-text">${st.midterm.summary}</p>`;
                    if (st.midterm.oustedIncumbents && st.midterm.oustedIncumbents.length > 0) {
                        html += `<div class="midterm-ousted-alert">⚠️ <strong>Ousted in Nov 2026:</strong> ${st.midterm.oustedIncumbents.join(', ')}</div>`;
                    }
                    panelMidtermBody.innerHTML = html;
                } else {
                    panelMidtermBox.style.display = 'none';
                }
            }

            // Senators
            if (st.senators.length > 0) {
                panelSenators.innerHTML = st.senators.map(m => renderMemberRow(m, st)).join('');
            } else {
                panelSenators.innerHTML = '<div class="empty-notice">No Senators recorded</div>';
            }

            // Reps
            repCountNum.textContent = st.reps.length;
            if (st.reps.length > 0) {
                panelReps.innerHTML = st.reps.map(m => renderMemberRow(m, st)).join('');
            } else {
                panelReps.innerHTML = '<div class="empty-notice">No Representatives recorded</div>';
            }

            panelPlaceholder.style.display = 'none';
            panelContent.style.display = 'block';
        }

        // Click on SVG paths (only if not dragged)
        if (mapWrapper) {
            mapWrapper.addEventListener('click', (e) => {
                if (hasMoved) return;
                const target = e.target.closest('.state-path');
                if (target) {
                    const code = target.getAttribute('data-state');
                    if (code) selectState(code);
                }
            });
        }

        // Change on dropdown
        if (stateSelect) {
            stateSelect.addEventListener('change', (e) => {
                selectState(e.target.value);
            });
        }

        // Initial viewbox setup: auto-fit entire USA
        resetZoom();

        // Default to Oklahoma on load
        selectState('OK');
    }
</script>

