---
import Layout from '../layouts/Layout.astro';
import actionsData from '../data/actions.json';

// Build events grouped by topic
const eventsMap = new Map<string, { id: string; date: string; title: string; chamber: string; proCount: number; antiCount: number }>();

actionsData.filter(a => a.eventId).forEach(action => {
    if (!eventsMap.has(action.eventId)) {
        eventsMap.set(action.eventId, {
            id: action.eventId,
            date: action.date,
            title: action.eventTitle,
            chamber: (action as any).chamber ?? (action.id.startsWith('sen-') ? 'senate' : 'house'),
            proCount: 0,
            antiCount: 0,
        });
    }
    const e = eventsMap.get(action.eventId)!;
    if (action.alignment === 'pro') e.proCount++;
    else e.antiCount++;
});

const allEvents = Array.from(eventsMap.values()).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Group events by topic
const topicMap = new Map<string, typeof allEvents>();
actionsData.filter(a => a.eventId).forEach(action => {
    if (!topicMap.has(action.topic)) topicMap.set(action.topic, []);
    const events = topicMap.get(action.topic)!;
    if (!events.find(e => e.id === action.eventId)) {
        events.push(eventsMap.get(action.eventId)!);
    }
});

// Sort topics by most recent event date
const sortedTopics = Array.from(topicMap.entries()).sort((a, b) => {
    const aLatest = a[1][0]?.date ?? '';
    const bLatest = b[1][0]?.date ?? '';
    return bLatest.localeCompare(aLatest);
});
---

<Layout title="Issues - Trump's Toadies">
    <div class="header-section">
        <h2>Issues</h2>
        <p class="subtitle">Votes and actions grouped by topic.</p>
    </div>

    {sortedTopics.map(([topic, events]) => (
        <div class="topic-section">
            <h3 class="topic-title">{topic} <span class="count">({events.length} vote{events.length !== 1 ? 's' : ''})</span></h3>
            <div class="event-list">
                {events.map(event => (
                    <a href={`${import.meta.env.BASE_URL}/events/${event.id}/`} class="event-row">
                        <span class="date">{event.date}</span>
                        <span class={`chamber-badge ${event.chamber}`}>{event.chamber === 'senate' ? 'S' : 'H'}</span>
                        <span class="title">{event.title}</span>
                        <div class="stats">
                            <span class="stat pro">{event.proCount} Yay</span>
                            {event.antiCount > 0 && <span class="stat anti">{event.antiCount} Nay</span>}
                        </div>
                    </a>
                ))}
            </div>
        </div>
    ))}
</Layout>

<style>
    .header-section {
        margin-bottom: 2rem;
    }
    .header-section h2 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }
    .header-section .subtitle {
        color: var(--color-muted);
        font-size: 1.1rem;
    }
    .topic-section {
        margin-bottom: 2.5rem;
    }
    .topic-title {
        font-size: 1.5rem;
        border-bottom: 2px solid var(--color-border);
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
    }
    .count {
        color: var(--color-muted);
        font-size: 1rem;
        font-weight: normal;
    }
    .event-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .event-row {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-left: 4px solid var(--color-accent);
        border-radius: 6px;
        padding: 0.875rem 1.25rem;
        color: var(--color-text);
        text-decoration: none;
        transition: background 0.1s;
        flex-wrap: wrap;
    }
    .event-row:hover {
        background: #f5f5f5;
        text-decoration: none;
    }
    .chamber-badge {
        font-size: 0.65rem;
        padding: 0.15rem 0.4rem;
        border-radius: 3px;
        font-weight: bold;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .chamber-badge.senate { background: #2c3e50; color: #fff; }
    .chamber-badge.house  { background: #7f8c8d; color: #fff; }
    .date {
        font-size: 0.8rem;
        color: var(--color-muted);
        white-space: nowrap;
    }
    .title {
        flex: 1;
        font-weight: 600;
    }
    .stats {
        display: flex;
        gap: 0.5rem;
    }
    .stat {
        font-size: 0.8rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        white-space: nowrap;
    }
    .stat.pro {
        background: #fdf2f2;
        color: #c0392b;
        border: 1px solid #f5b7b1;
    }
    .stat.anti {
        background: #ebf5fb;
        color: #2980b9;
        border: 1px solid #a9cce3;
    }
</style>
