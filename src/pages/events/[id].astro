---
import Layout from '../../layouts/Layout.astro';
import actionsData from '../../data/actions.json';
import subjectsData from '../../data/subjects.json';
import eventsMeta from '../../data/events_meta.json';

export async function getStaticPaths() {
  // Get unique event IDs, filtering out any missing/undefined ones
  const eventIds = [...new Set(actionsData.map(a => a.eventId).filter(Boolean))];
  
  return eventIds.map(eventId => {
    const eventActions = actionsData.filter(a => a.eventId === eventId);
    const event = {
        id: eventId,
        date: eventActions[0].date,
        topic: eventActions[0].topic,
        title: eventActions[0].eventTitle,
        description: eventActions[0].description.replace(/^Voted .*? on (the Motion to Discharge )?/, '').replace(/^Voted .*? on /, ''),
        sourceUrl: eventActions[0].sourceUrl
    };
    return {
      params: { id: eventId },
      props: { event, eventActions },
    };
  });
}

const { event, eventActions } = Astro.props;

const meta = (eventsMeta as any)[event.id] ?? null;

// Map subjects to actions
const fullActions = eventActions.map(action => {
    const subject = subjectsData.find(s => s.id === action.subjectId);
    return { ...action, subject };
});

const byState = (a: any, b: any) => (a.subject?.state ?? '').localeCompare(b.subject?.state ?? '') || (a.subject?.name ?? '').localeCompare(b.subject?.name ?? '');
const proActions = fullActions.filter(a => a.alignment === 'pro').sort(byState);
const antiActions = fullActions.filter(a => a.alignment === 'anti').sort(byState);

const getMajorityParty = (actions) => {
    const counts = actions.reduce((acc, a) => {
        const party = a.subject?.party || 'Independent';
        acc[party] = (acc[party] || 0) + 1;
        return acc;
    }, {});
    return Object.keys(counts).reduce((a, b) => (counts[a] || 0) > (counts[b] || 0) ? a : b, 'Independent');
};

const proMajorityParty = getMajorityParty(proActions);
const antiMajorityParty = getMajorityParty(antiActions);
---

<Layout title={`${event.title} - Trump's Toadies`}>
    <div class="event-header">
        <a href={`${import.meta.env.BASE_URL}/`}>&larr; Back to Feed</a>
        <div class="meta">
            <span class="date">{event.date}</span>
            <span class="topic">{event.topic}</span>
        </div>
        <h2>{event.title}</h2>
        <p class="description">{event.description}</p>

        {meta?.summary && (
          <div class="ai-summary">
            <p class="summary-text">{meta.summary}</p>
            <div class="vote-rationale">
              {meta.why_yes && (
                <div class="rationale pro">
                  <span class="rationale-label">✓ Case for Yea</span>
                  {meta.why_yes}
                </div>
              )}
              {meta.why_no && (
                <div class="rationale anti">
                  <span class="rationale-label">✗ Case for Nay</span>
                  {meta.why_no}
                </div>
              )}
            </div>
            {meta.trump_signal && (
              <div class="trump-signal">
                <strong>Trump alignment:</strong> {meta.trump_signal}
              </div>
            )}
            {meta.tags && meta.tags.length > 0 && (
              <div class="tag-row">
                {meta.tags.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
            )}
            <p class="ai-label">AI-generated summary · <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer">View official record</a></p>
          </div>
        )}

        {event.sourceUrl && (
            <div class="source-link-container">
                <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer" class="btn outline">View Official Record</a>
            </div>
        )}
    </div>

    <div class="legend">
        <span class="legend-label">Column Colors (Majority Party):</span>
        <span class="legend-item"><span class="party-dot party-republican"></span> Republican</span>
        <span class="legend-item"><span class="party-dot party-democrat"></span> Democrat</span>
        <span class="legend-item"><span class="party-dot party-independent"></span> Independent</span>
        <span class="legend-item">Example: <span class="badge">Nay</span></span>
    </div>

    <div class="actions-container">
        {proActions.length > 0 && (
            <div class="action-column pro-column">
                <div class={`column-header party-${proMajorityParty.toLowerCase()}`}>
                    <h3>Yay</h3>
                    <span class="count">{proActions.length}</span>
                </div>
                <p class="column-desc">Voted Yea on this measure.</p>
                <div class="subject-list">
                    {proActions.map(action => (
                        <a href={`${import.meta.env.BASE_URL}/subjects/${action.subject?.id}/`} class="subject-row">
                            <div class="subject-name">
                                <strong>{action.subject?.name}</strong>
                                <span class="badge">{action.subject?.state}</span>
                                <span class={`party-dot party-${action.subject?.party?.toLowerCase()}`} title={action.subject?.party}></span>
                            </div>
                            <div class="vote-text">{action.title.split(' on ')[0]}</div>
                        </a>
                    ))}
                </div>
            </div>
        )}

        {antiActions.length > 0 && (
            <div class="action-column anti-column">
                <div class={`column-header party-${antiMajorityParty.toLowerCase()}`}>
                    <h3>Nay</h3>
                    <span class="count">{antiActions.length}</span>
                </div>
                <p class="column-desc">Voted Nay on this measure.</p>
                <div class="subject-list">
                    {antiActions.map(action => (
                        <a href={`${import.meta.env.BASE_URL}/subjects/${action.subject?.id}/`} class="subject-row">
                            <div class="subject-name">
                                <strong>{action.subject?.name}</strong>
                                <span class="badge">{action.subject?.state}</span>
                                <span class={`party-dot party-${action.subject?.party?.toLowerCase()}`} title={action.subject?.party}></span>
                            </div>
                            <div class="vote-text">{action.title.split(' on ')[0]}</div>
                        </a>
                    ))}
                </div>
            </div>
        )}
    </div>
</Layout>

<style>
    .ai-summary { background: #f8f9fa; border: 1px solid #e9ecef; border-left: 3px solid #95a5a6; border-radius: 6px; padding: 1rem 1.25rem; margin: 1rem 0; }
    .summary-text { margin-bottom: 0.75rem; }
    .vote-rationale { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
    @media (max-width: 600px) { .vote-rationale { grid-template-columns: 1fr; } }
    .rationale { font-size: 0.875rem; border-radius: 4px; padding: 0.6rem 0.75rem; border: 1px solid; }
    .rationale.pro { background: #fdf8f8; border-color: #f5b7b1; color: #444; }
    .rationale.anti { background: #f8fbff; border-color: #a9cce3; color: #444; }
    .rationale-label { display: block; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.25rem; }
    .rationale.pro .rationale-label { color: #c0392b; }
    .rationale.anti .rationale-label { color: #2980b9; }
    .trump-signal { font-size: 0.875rem; color: #555; background: #fff; border: 1px solid #e9ecef; border-radius: 4px; padding: 0.5rem 0.75rem; margin-bottom: 0.75rem; }
    .tag-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
    .tag { font-size: 0.7rem; padding: 0.15rem 0.5rem; background: #eee; border-radius: 12px; color: #555; }
    .ai-label { font-size: 0.75rem; color: var(--color-muted); margin: 0; }

    .event-header {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-top: 4px solid var(--color-text);
        padding: 2rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }
    .event-header > a {
        display: inline-block;
        margin-bottom: 1.5rem;
        color: var(--color-muted);
    }
    .meta {
        display: flex;
        gap: 1rem;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
        color: var(--color-muted);
    }
    .topic {
        font-weight: bold;
        color: var(--color-text);
    }
    .event-header h2 {
        font-size: 2.5rem;
        line-height: 1.2;
        margin-bottom: 1rem;
    }
    .description {
        font-size: 1.25rem;
        margin-bottom: 1.5rem;
        color: #444;
    }
    .source-link-container {
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
    }
    .btn.outline {
        border: 2px solid var(--color-text);
        color: var(--color-text);
        background: transparent;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-weight: bold;
        display: inline-block;
    }
    .btn.outline:hover {
        background: var(--color-text);
        color: #fff;
        text-decoration: none;
    }

    .actions-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
    @media (max-width: 768px) {
        .actions-container {
            grid-template-columns: 1fr;
        }
    }
    
    .action-column {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        overflow: hidden;
    }
    .column-header {
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--color-border);
    }
    .column-header h3 {
        margin: 0;
        font-size: 1.5rem;
    }
    .column-header.party-republican { background: #fdf2f2; border-bottom-color: #f5b7b1; }
    .column-header.party-republican h3, .column-header.party-republican .count { color: #c0392b; }
    .column-header.party-democrat { background: #ebf5fb; border-bottom-color: #a9cce3; }
    .column-header.party-democrat h3, .column-header.party-democrat .count { color: #2980b9; }
    .column-header.party-independent { background: #f9f9f9; border-bottom-color: #ccc; }
    .column-header.party-independent h3, .column-header.party-independent .count { color: #555; }
    
    .legend { display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: center; font-size: 0.9rem; color: #555; background: #fff; padding: 0.75rem 1rem; border-radius: 6px; border: 1px solid var(--color-border); }
    .legend-label { font-weight: bold; }
    .legend-item { display: flex; align-items: center; gap: 0.4rem; }
    .legend-item .badge { background: #eee; color: #333; font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 4px; }
    
    .count {
        font-size: 1.5rem;
        font-weight: bold;
    }
    .column-desc {
        padding: 1rem 1.5rem;
        font-size: 0.95rem;
        color: var(--color-muted);
        border-bottom: 1px solid var(--color-border);
        background: #fafafa;
    }
    
    .subject-list {
        max-height: 600px;
        overflow-y: auto;
    }
    .subject-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #eee;
        color: var(--color-text);
        text-decoration: none;
        transition: background 0.1s;
    }
    .subject-row:hover {
        background: #f5f5f5;
        text-decoration: none;
    }
    .subject-row:last-child {
        border-bottom: none;
    }
    .subject-name {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .badge {
        font-size: 0.7rem;
        background: #eee;
        color: #666;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        font-weight: bold;
    }
    .party-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .party-republican { background: #e74c3c; }
    .party-democrat { background: #3498db; }
    .party-independent { background: #95a5a6; }
    
    .vote-text {
        font-weight: 500;
        font-size: 0.9rem;
    }
</style>