---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Tracking congressional voting records and loyalty to Donald Trump's legislative agenda." } = Astro.props;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://trumpstoadies.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalUrl} />

		<!-- OpenGraph / Social Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Trump's Toadies" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
        <header class="site-header">
            <div class="container">
                <h1><a href={`${import.meta.env.BASE_URL}/`}>Trump's Toadies</a></h1>
                <nav>
                    <a href={`${import.meta.env.BASE_URL}/`}>The Feed</a>
                    <a href={`${import.meta.env.BASE_URL}/people/`}>People</a>
                    <a href={`${import.meta.env.BASE_URL}/issues/`}>Issues</a>
                    <a href={`${import.meta.env.BASE_URL}/rankings/`}>Rankings</a>
                    <a href={`${import.meta.env.BASE_URL}/lies/`}>Lies</a>
                </nav>
            </div>
        </header>
        <main class="container">
		    <slot />
        </main>
        <footer class="site-footer">
            <div class="container">
                <p>Tracking congressional voting records and loyalty to Donald Trump's legislative agenda.</p>
                <p class="footer-meta">Data sourced from official roll call records at <a href="https://clerk.house.gov" target="_blank" rel="noopener">clerk.house.gov</a> and <a href="https://www.senate.gov" target="_blank" rel="noopener">senate.gov</a>.</p>
            </div>
        </footer>
	</body>
</html>
<style is:global>
	:root {
		--color-bg: #f9f9f9;
		--color-text: #111;
		--color-accent: #c0392b; /* Warning red */
		--color-border: #ddd;
        --color-card: #fff;
        --color-muted: #666;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
	}
	* {
		box-sizing: border-box;
        margin: 0;
        padding: 0;
	}
	body {
		font-family: var(--font-sans);
		background-color: var(--color-bg);
		color: var(--color-text);
        line-height: 1.6;
	}
    a {
        color: var(--color-accent);
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 1rem;
    }
    .site-header {
        background: #111;
        color: #fff;
        padding: 1rem 0;
        margin-bottom: 2rem;
    }
    .site-header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .site-header h1 a {
        color: #fff;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .site-header nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0;
        justify-content: flex-end;
    }
    .site-header nav a {
        color: #ddd;
        margin-left: 0.75rem;
    }
    .site-header nav a:hover {
        color: #fff;
    }
    .site-footer {
        margin-top: 4rem;
        padding: 2rem 0;
        border-top: 1px solid var(--color-border);
        color: var(--color-muted);
        font-size: 0.875rem;
        text-align: center;
    }
    .site-footer .footer-meta {
        margin-top: 0.5rem;
        font-size: 0.8rem;
    }
    .site-footer a {
        color: var(--color-muted);
        text-decoration: underline;
    }
    .site-footer a:hover {
        color: var(--color-text);
    }
    @media (max-width: 540px) {
        .site-header .container {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
        .site-header nav {
            justify-content: flex-start;
        }
        .site-header nav a {
            margin-left: 0;
            margin-right: 0.75rem;
            font-size: 0.85rem;
        }
    }
</style>